APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Madrid

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sevilla_matrix
DB_USER=sevilla_user
DB_PASS=change_me

# Genera uno con: php -r "echo password_hash('tu-clave', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=

# AirLabs admite hasta tres claves autorizadas. También se conserva
# AIRLABS_API_KEY como compatibilidad con instalaciones anteriores.
AIRLABS_API_KEY_1=
AIRLABS_API_KEY_2=
AIRLABS_API_KEY_3=
AIRLABS_API_KEY=
# Alternativa: una lista separada por comas.
AIRLABS_API_KEYS=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# FlightAware AeroAPI (API de pago). Usa UNA de estas claves; se prueba en este orden.
# Documentación: https://www.flightaware.com/aeroapi/portal/documentation
# Header: x-apikey. Solo GET /flights/{ident} (ICAO VLG3190 o IATA VY3190); nunca listados de aeropuerto.
# Cobro = result sets (páginas ≤15 vuelos). Mes calendario Europe/Madrid.
# Plan regalado ~2500; tope duro 2300 (margen 200). Prioridad: vigilados → Canarias noche →
# Canarias → feeder → nube ±30 min. El resto de SVQ no consume cuota.
FLIGHTAWARE_API_KEY=
AEROAPI_KEY=
FLIGHTAWARE_AEROAPI_KEY=
AEROAPI_MONTHLY_LIMIT=2300
AEROAPI_CADENCE_MINUTES=5
AEROAPI_STALE_MINUTES=20

# Frecuencias reales de las tareas programadas. El panel usa estos valores
# para distinguir un cron retrasado de una cadencia deliberadamente baja.
AIRLABS_CADENCE_MINUTES=60
AIRLABS_STALE_MINUTES=150
OPENSKY_CADENCE_MINUTES=5
OPENSKY_STALE_MINUTES=20
WEATHER_CADENCE_MINUTES=10
WEATHER_STALE_MINUTES=35
VAPID_SUBJECT=mailto:admin@ojito.top

# Token largo y aleatorio usado por el recolector Aena de GitHub Actions.
# Debe coincidir con el secreto MATRIX_INGEST_TOKEN del repositorio.
AENA_INGEST_TOKEN=

# Opcional. PAT de GitHub con permiso actions:write para el botón
# «Actualizar Aena» del Centro de procesos. Sin él, el botón solo marca
# la captura como urgente y espera al siguiente ciclo (máx. 5 min).
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=guchumu5/sevilla-flight-matrix
GITHUB_DISPATCH_REF=main

POLL_SECONDS=15
