APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Madrid

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sevilla_matrix
DB_USER=sevilla_user
DB_PASS=change_me

# Genera uno con: php -r "echo password_hash('tu-clave', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=

# AirLabs admite hasta tres claves autorizadas. También se conserva
# AIRLABS_API_KEY como compatibilidad con instalaciones anteriores.
AIRLABS_API_KEY_1=
AIRLABS_API_KEY_2=
AIRLABS_API_KEY_3=
AIRLABS_API_KEY=
# Alternativa: una lista separada por comas.
AIRLABS_API_KEYS=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Token largo y aleatorio usado por el recolector Aena de GitHub Actions.
# Debe coincidir con el secreto MATRIX_INGEST_TOKEN del repositorio.
AENA_INGEST_TOKEN=

POLL_SECONDS=15
